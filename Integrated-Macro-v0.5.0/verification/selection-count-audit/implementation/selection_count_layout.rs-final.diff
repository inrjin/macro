+struct LabelScope { label: Bounds, outer: Bounds, connected: Vec<bool> }
+impl LabelScope {
+    fn contains(&self, x:usize, y:usize)->bool {
+        self.label.has_point(x,y) || (self.outer.has_point(x,y)
+            && self.connected[(y-self.outer.top)*self.outer.width()+x-self.outer.left])
+    }
+}
+
+fn label_scope(frame:RgbaView<'_>,label:Bounds,padding:usize,background:[u8;3])->Option<LabelScope> {
+    let outer=label.padded(padding,frame.width as usize,frame.height as usize);
+    let mut connected=vec![false;outer.width()*outer.height()];
+    // Only a directly adjacent antialiased fringe belongs to the label. A
+    // transitive flood through near-background pixels can swallow another tiny
+    // character that merely touches that fringe.
+    for y in label.top..label.bottom {for x in label.left..label.right {
+        if pixel(frame,x,y)?==background {continue;}
+        for (nx,ny) in [x.checked_sub(1).map(|nx|(nx,y)),(x+1<outer.right).then_some((x+1,y)),
+            y.checked_sub(1).map(|ny|(x,ny)),(y+1<outer.bottom).then_some((x,y+1))].into_iter().flatten() {
+            if outer.has_point(nx,ny) && !label.has_point(nx,ny) && pixel(frame,nx,ny)?!=background {
+                connected[(ny-outer.top)*outer.width()+nx-outer.left]=true;
+            }
+        }
+    }}
+    Some(LabelScope{label,outer,connected})
 }
 
