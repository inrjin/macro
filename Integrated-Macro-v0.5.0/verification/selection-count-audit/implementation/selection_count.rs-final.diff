+// Numeric authorization needs to reject contradictory empty text even when a
+// font's connected anchors miss its word bounds. This separate path proposes
+// actual bounded text lines, then applies the unchanged whole-word score. Its
+// extra references can only withhold a number; they never authorize zero.
+fn possible_empty_line(mask:&[bool],width:usize,height:usize,boxes:&[Box2])->Result<bool,CountIssue> {
+    let references:Vec<_>=templates().iter().filter(|t|t.label=="empty_negative").collect();
+    let min_ratio=references.iter().map(|t|t.width as f64/t.height as f64).fold(f64::INFINITY,f64::min)*0.85;
+    let max_ratio=references.iter().map(|t|t.width as f64/t.height as f64).fold(0.0_f64,f64::max)*1.15;
+    let mut rows:Vec<_>=boxes.iter().copied().collect();rows.sort_by_key(|b|b.y);
+    let mut rejected_patterns=HashSet::new();let mut scanned_rows=HashSet::new();
+    let(mut examined,mut compared_pixels,mut stored_pixels)=(0usize,0usize,0usize);
+    for seed in boxes {
+        if !(6..=96).contains(&seed.h) || seed.w>100 || seed.pixels<10 {continue;}
+        let top=seed.y.saturating_sub(seed.h/3);
+        let bottom=(seed.y+seed.h+seed.h/3+1).min(height);
+        // The candidate row set, component-height filter and join distance
+        // depend only on this key, not on the seed's x/pixels/width. Repeated
+        // seats on one row must not consume the uncertainty budget repeatedly.
+        if !scanned_rows.insert((top,bottom,seed.h)) {continue;}
+        let first=rows.partition_point(|b|b.y<top);
+        let last=rows.partition_point(|b|b.y<bottom);
+        examined+=last-first;
+        // Exhaustion is uncertainty, never absence of contradictory text.
+        if examined>2_000_000 {return Err(CountIssue::NumericContext);}
+        let mut line:Vec<_>=rows[first..last].iter().copied()
+            .filter(|b|b.y+b.h<=bottom && b.h<=seed.h*3/2+1).collect();
+        line.sort_by_key(|b|b.x);
+        let mut start=0;
+        while start<line.len() {
+            let mut right=line[start].x+line[start].w;let mut end=start+1;
+            while end<line.len() && line[end].x<=right+(seed.h*3/4).max(2) {
+                right=right.max(line[end].x+line[end].w);end+=1;
+            }
+            // Nearby UI can share the row. Inspect contiguous bounded portions,
+            // not only the maximal chain that would include unrelated words.
+            for left in start..end {
+                let mut region=line[left];
+                for last in left..end {
+                    examined+=1;
+                    if examined>2_000_000 {return Err(CountIssue::NumericContext);}
+                    let b=line[last];let right=(region.x+region.w).max(b.x+b.w);
+                    let lower=(region.y+region.h).max(b.y+b.h);
+                    region.y=region.y.min(b.y);region.w=right-region.x;region.h=lower-region.y;
+                    if region.w as f64>max_ratio*(bottom-top) as f64 {break;}
+                    let ratio=region.w as f64/region.h as f64;
+                    if last-left+1<4 || !(min_ratio..=max_ratio).contains(&ratio) {continue;}
+                    let area=region.w*region.h;
+                    compared_pixels+=area;
+                    if compared_pixels>128*1024*1024 {return Err(CountIssue::NumericContext);}
+                    let mut pixels=Vec::with_capacity(area);
+                    for y in region.y..region.y+region.h {
+                        pixels.extend(mask[y*width+region.x..y*width+region.x+region.w].iter().map(|&v|u8::from(v)));
+                    }
+                    // Scoring depends on dimensions and these exact binary
+                    // pixels, not their screen position. HashSet also checks
+                    // byte equality; a hash collision cannot suppress text.
+                    let key=(region.w,region.h,pixels);
+                    if rejected_patterns.contains(&key) {continue;}
+                    if rejected_patterns.len()>=1024 || stored_pixels+area>4*1024*1024 {
+                        return Err(CountIssue::NumericContext);
+                    }
+                    for template in &references {
+                        let relative=ratio/(template.width as f64/template.height as f64);
+                        if (relative-1.0).abs()<=0.16
+                            && score_at_least(mask,width,height,region,template,0.77)>=0.77 {return Ok(true);}
+                    }
+                    stored_pixels+=area;rejected_patterns.insert(key);
+                }
+            }
+            start=end;
+        }
+    }
+    Ok(false)
+}
