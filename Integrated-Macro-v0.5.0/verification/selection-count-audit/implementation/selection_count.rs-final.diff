+fn uniform_heading_ink(frame:RgbaView<'_>,heading:Box2)->bool {
+    // A differently colored tiny numeral can touch the heading's final stroke
+    // and disappear into its binary component. For the empty-state fallback,
+    // require one ink color direction. Normalizing white-background deficits
+    // preserves antialias coverage and supports uniformly colored headings.
+    // This does not distinguish same-color glyphs that overlap each other.
+    let mut inks=Vec::new();
+    for y in heading.y..heading.y+heading.h {for x in heading.x..heading.x+heading.w {
+        let p=&frame.rgba[y*frame.stride+x*4..][..3];
+        let deficit=[255-p[0],255-p[1],255-p[2]];
+        let strength=*deficit.iter().max().unwrap();
+        if strength<48 {continue;}
+        inks.push(deficit.map(|value|(u16::from(value)*255/u16::from(strength)) as u8));
+    }}
+    if inks.is_empty() {return false;}
+    let mut center=[0u8;3];
+    for channel in 0..3 {
+        let mut values:Vec<_>=inks.iter().map(|ink|ink[channel]).collect();
+        values.sort_unstable();center[channel]=values[values.len()/2];
+    }
+    inks.iter().all(|ink|ink.iter().zip(center).all(|(value,reference)|value.abs_diff(reference)<=48))
 }
 
