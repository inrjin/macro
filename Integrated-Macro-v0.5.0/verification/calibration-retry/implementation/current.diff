+fn physical_restart_block_reason(context: &RestartContext, target_id: Option<u64>, frame: Option<&OwnedFrame>)
+    -> Option<RestartBlockReason> {
+    if target_id.is_none() || context.target_id != target_id { return Some(RestartBlockReason::WindowChanged); }
+    let (Some(geometry),Some(frame)) = (context.geometry.as_ref(),frame) else {
+        return Some(RestartBlockReason::GeometryUnavailable);
+    };
+    if !same_frame_reference(geometry,frame) { return Some(RestartBlockReason::GeometryChanged); }
+    None
+}
+
+fn restart_block_reason(context: &RestartContext, target_id: Option<u64>, frame: Option<&OwnedFrame>,
+    next: &Profile, mode: RunMode) -> Option<RestartBlockReason> {
+    if let Some(reason) = physical_restart_block_reason(context,target_id,frame) { return Some(reason); }
+    if let Some(reason) = selection_policy_mismatch(&context.engine,next) { return Some(reason); }
+    if !same_search_mapping(&context.engine,next,mode) { return Some(RestartBlockReason::NavigationChanged); }
+    None
 }
 
