+fn preserve_restart_provenance(mut current: RestartContext, previous: Option<&RestartContext>) -> RestartContext {
+    if let Some(previous) = previous.filter(|previous| previous.run_id == current.run_id
+        && (previous.engine.has_retained_selection() || previous.engine.has_unresolved_conflict())
+        && (current.engine.has_retained_selection() || current.engine.has_unresolved_conflict())) {
+        // A failed capture/restart is not a new physical origin for old seats.
+        // Preserve even an unknown original geometry until validation succeeds.
+        current.target_id = previous.target_id;
+        current.geometry = previous.geometry.clone();
+    }
+    current
