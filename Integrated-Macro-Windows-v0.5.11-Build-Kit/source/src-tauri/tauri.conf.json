{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Integrated Macro",
  "version": "0.5.11",
  "identifier": "dev.integrated-macro.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "통합 매크로 0.5.11",
        "width": 1180,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#10141c"
      },
      {
        "label": "status",
        "title": "통합 매크로 상태",
        "url": "overlay.html",
        "width": 420,
        "height": 86,
        "x": 24,
        "y": 36,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "backgroundColor": "#10141c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "공통 엔진을 사용하는 화면 매크로",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}

